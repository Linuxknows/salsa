# Compiled binaries, objects, and build artifacts
build/
*.o
*.so
*.so.*
*.a

# Rust / Cargo build outputs
target/
rust/*/target/
rust_target/

# Fuzzer crash and artifact outputs
crash-*
leak-*
oom-*
timeout-*

# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Release/installer archives and temporary files
*.zip
*.tmp
*.log
*.jsonl

# Editor and OS files
*.swp
*~
.DS_Store

# Local agent scratch specs and tickets
.scratch/
